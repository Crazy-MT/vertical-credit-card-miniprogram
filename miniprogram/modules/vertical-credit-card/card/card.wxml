<view class="vc-view viewport" style="{{viewportStyle}}" bindtouchstart="startTilt" bindtouchmove="moveTilt" bindtouchend="endTilt" bindtouchcancel="endTilt">
  <view class="vc-view scale" style="{{scaleStyle}}"><view class="vc-view tilt" style="{{tiltStyle}}"><view class="vc-view card {{isExpired ? 'expired' : ''}} {{rgb ? 'rgb' : ''}}" style="{{cardStyle}}" bindtap="tapCard">
    <view class="vc-view flipper" style="{{flipStyle}}">
      <view class="vc-view face front">
        <image wx:if="{{theme.backgroundImage}}" class="vc-image background" src="{{theme.backgroundImage}}" mode="scaleToFill" />
        <canvas wx:if="{{theme.id === 'chromaticFluid' || theme.id === 'revolutChromatic'}}" type="2d" class="fluid-canvas" />
        <view class="vc-view front-content finish-{{finish}}" style="{{textFoilStyle}}"><view class="vc-view top"><view class="vc-view bank"><slot name="bank-logo"></slot><text wx:if="{{!useBankLogo}}" class="vc-text">{{bankName}}</text></view><view class="vc-view badge"><slot name="action-badge"></slot></view><view class="vc-view contactless"><view class="vc-view"></view><view class="vc-view"></view><view class="vc-view"></view></view></view>
          <view class="vc-view chip-row"><image wx:if="{{!useChipWidget}}" class="chip-image" src="/modules/vertical-credit-card/assets/chip_{{theme.chipColor}}.png" /><slot name="chip"></slot><text class="vc-text arrow">↑</text></view>
          <view class="vc-view bottom"><view class="vc-view number" catchtap="togglePrivacy"><text class="vc-text foil-text">{{numberText}}</text><text class="vc-text eye">{{privateMode ? '◉' : '◎'}}</text></view><view class="vc-view details"><view class="vc-view owner"><view class="vc-view expiry"><text class="vc-text label">VAL THRU</text><text class="vc-text foil-text">{{expiryText}}</text></view><view class="vc-view holder foil-text">{{holderText}}</view><slot name="balance"></slot></view><view class="network network-{{brandId}}"><text wx:if="{{brandId === 'visa'}}" class="visa-wordmark">VISA</text><view wx:elif="{{brandId === 'mastercard'}}" class="mastercard-mark"><view class="mastercard-red"></view><view class="mastercard-yellow"></view></view><text wx:elif="{{brandId === 'americanExpress'}}" class="amex-wordmark">AMEX</text><view wx:elif="{{brandId === 'discover'}}" class="discover-wordmark"><text class="discover-text">DISC</text><view class="discover-sun"></view><text class="discover-text">VER</text></view><view wx:else class="generic-mark"><view class="generic-card"><view class="generic-stripe"></view></view></view></view></view></view>
        </view>
      </view>
      <view class="vc-view face back"><canvas wx:if="{{theme.id === 'chromaticFluid' || theme.id === 'revolutChromatic'}}" type="2d" class="fluid-canvas" /><image wx:if="{{theme.backgroundImage}}" class="vc-image background" src="{{theme.backgroundImage}}" mode="scaleToFill" /><view class="vc-view stripe"></view><view class="vc-view signature-area"><view class="vc-view signature-label">AUTHORIZED SIGNATURE • NOT VALID UNLESS SIGNED</view><view class="vc-view signature-row"><view class="vc-view signature">John Doe</view><view class="vc-view cvv"><rolling-digit text="{{cvvText}}" /></view></view></view><view class="vc-view back-footer"><text class="vc-text">This card is issued pursuant to license by the financial institution. Use of this card is governed by the cardholder agreement.</text><image class="security-image" src="/modules/vertical-credit-card/assets/security.png" /></view></view>
    </view>
    <canvas type="2d" class="overlay effect-canvas" />
    <view wx:if="{{isFrozen || melting}}" class="vc-view overlay frost {{melting ? 'melting' : ''}}"><image class="frost-texture" src="/modules/vertical-credit-card/assets/frost.png" mode="scaleToFill" /><view class="freeze-lock"><view class="freeze-shackle"></view><view class="freeze-body">•</view></view><text class="vc-text frozen-label">FROZEN</text></view>
    <view wx:if="{{isExpired}}" class="vc-view overlay expired-stamp"><text class="vc-text">EXPIRED</text></view>
  </view></view></view>
</view>
