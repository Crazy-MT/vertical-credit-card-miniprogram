page{background:#f4f7fb}.lab{padding:36rpx 28rpx 80rpx}.title{font-size:48rpx;font-weight:800;color:#132334}.subtitle{color:#758497;font-size:24rpx;margin-top:8rpx}.tabs{display:flex;margin:30rpx 0;gap:8rpx}.tabs .vc-text{padding:16rpx 14rpx;background:#e8eef5;border-radius:16rpx;font-size:24rpx;flex:1;text-align:center;white-space:nowrap}.tabs .active{background:#172c45;color:#fff}.theme-picker{display:flex;justify-content:space-between;padding:24rpx;background:white;border-radius:18rpx;font-size:28rpx}.theme-picker>.vc-text{color:#007aff;font-size:24rpx}.preview{text-align:center;padding:40rpx 0 24rpx}.hint{color:#8492a3;font-size:22rpx;margin-top:24rpx;text-align:center;line-height:1.6}.buttons{display:flex;gap:12rpx;justify-content:center;flex-wrap:wrap}.buttons .vc-button{margin:0;font-size:22rpx;background:#e5edf8;color:#245079}.panel{background:white;border-radius:24rpx;padding:28rpx;margin-top:28rpx}.panel-title{font-size:30rpx;font-weight:700;margin-bottom:24rpx;color:#182b40}.toggles{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.toggles>.vc-view{display:flex;justify-content:space-between;align-items:center;gap:8rpx}.toggles .vc-text{font-size:24rpx}.toggles .vc-switch{transform:scale(.7);transform-origin:right center}.wallet{padding:36rpx 0}.color-row{display:flex;align-items:center;justify-content:space-between;padding:16rpx 0;font-size:28rpx}.color-row .vc-input{background:#f2f5fa;padding:12rpx 20rpx;border-radius:12rpx;width:200rpx}
