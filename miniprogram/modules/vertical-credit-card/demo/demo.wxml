<view class="vc-view lab"><view class="vc-view title">Vertical Card</view><view class="vc-view subtitle">原库预设 · 交互卡片 · 独立模块</view><view class="vc-view tabs"><text wx:for="{{modes}}" wx:key="id" data-mode="{{item.id}}" class="vc-text {{mode === item.id ? 'active' : ''}}" bindtap="changeMode">{{item.label}}</text></view>
  <view wx:if="{{mode === 'wallet'}}" class="vc-view wallet"><vertical-card-stack class="wallet-stack" cards="{{walletCards}}" bind:cardselected="cardSelected" /><view class="vc-view hint">{{selectedCard >= 0 ? '再次点击卡片收起' : '点击任意卡片展开'}}</view></view>
  <block wx:else>
    <picker range="{{presetNames}}" value="{{presetIndex}}" bindchange="changePreset"><view class="vc-view theme-picker">{{presetNames[presetIndex]}}<text class="vc-text">更换预设 ›</text></view></picker>
    <view class="vc-view preview"><vertical-card class="main-card" preset="{{preset}}" card-theme="{{mode === 'studio' ? customTheme : null}}" bank-name="{{bankName}}" card-number="{{cardNumber}}" card-holder="{{cardHolder}}" expiry-date="{{expiryDate}}" cvv="{{cvv}}" is-frozen="{{frozen}}" is-expired="{{expired}}" is-privacy-mode="{{privateMode}}" is-flipped="{{flipped}}" enable-3-d-tilt="{{tilt}}" enable-specular-glare="{{glare}}" enable-holographic-foil="{{holographic}}" enable-edge-glow="{{edgeGlow}}" enable-diamond-dust="{{diamondDust}}" enable-payment-pulse="{{paymentPulse}}" is-rgb-chroma="{{rgb}}" text-finish="{{textFinish}}" bind:flipchange="flipChanged" bind:privacychange="privacyChanged" /><view class="vc-view hint">点击翻面 · 拖动倾斜 · 点击卡号切换隐私</view></view>
    <view class="vc-view buttons"><button class="vc-button" size="mini" bindtap="flip">{{flipped ? '查看正面' : '查看背面'}}</button><button class="vc-button" size="mini" bindtap="regenerateCvv">更新演示 CVV</button><button class="vc-button" size="mini" bindtap="exportConfig">复制配置</button></view>
    <view wx:if="{{mode === 'checkout'}}" class="vc-view panel"><view class="vc-view panel-title">实时输入联动</view><vertical-card-input-form class="card-input" card-number="{{cardNumber}}" card-holder="{{cardHolder}}" expiry-date="{{expiryDate}}" cvv="{{cvv}}" bind:cardnumberchanged="numberChanged" bind:cardholderchanged="holderChanged" bind:expirychanged="expiryChanged" bind:cvvchanged="cvvChanged" bind:cvvfocuschanged="cvvFocusChanged" /><view class="vc-view hint">演示数据仅用于预览，输入 CVV 时自动翻面。</view></view>
    <view wx:if="{{mode === 'studio'}}" class="vc-view panel"><view class="vc-view panel-title">自定义外观</view><view class="vc-view color-row"><text class="vc-text">背景颜色</text><input class="vc-input" value="{{color}}" bindinput="colorChanged" maxlength="7" /></view><view class="vc-view color-row"><text class="vc-text">文字颜色</text><input class="vc-input" value="{{textColor}}" bindinput="textColorChanged" maxlength="7" /></view><picker range="{{finishes}}" value="{{finishIndex}}" bindchange="finishChanged"><view class="vc-view theme-picker">文字工艺：{{textFinish}} ›</view></picker></view>
    <view class="vc-view panel"><view class="vc-view panel-title">状态与光效</view><view class="vc-view toggles"><view class="vc-view"><text class="vc-text">冻结 / 解冻</text><switch class="vc-switch" checked="{{frozen}}" data-key="frozen" bindchange="changeFlag" /></view><view class="vc-view"><text class="vc-text">过期</text><switch class="vc-switch" checked="{{expired}}" data-key="expired" bindchange="changeFlag" /></view><view class="vc-view"><text class="vc-text">隐私模式</text><switch class="vc-switch" checked="{{privateMode}}" data-key="privateMode" bindchange="changeFlag" /></view><view class="vc-view"><text class="vc-text">3D 倾斜</text><switch class="vc-switch" checked="{{tilt}}" data-key="tilt" bindchange="changeFlag" /></view><view class="vc-view"><text class="vc-text">镜面反光</text><switch class="vc-switch" checked="{{glare}}" data-key="glare" bindchange="changeFlag" /></view><view class="vc-view"><text class="vc-text">全息镀膜</text><switch class="vc-switch" checked="{{holographic}}" data-key="holographic" bindchange="changeFlag" /></view><view class="vc-view"><text class="vc-text">边缘光束</text><switch class="vc-switch" checked="{{edgeGlow}}" data-key="edgeGlow" bindchange="changeFlag" /></view><view class="vc-view"><text class="vc-text">钻石微光</text><switch class="vc-switch" checked="{{diamondDust}}" data-key="diamondDust" bindchange="changeFlag" /></view><view class="vc-view"><text class="vc-text">非接触脉冲</text><switch class="vc-switch" checked="{{paymentPulse}}" data-key="paymentPulse" bindchange="changeFlag" /></view><view class="vc-view"><text class="vc-text">RGB 流光</text><switch class="vc-switch" checked="{{rgb}}" data-key="rgb" bindchange="changeFlag" /></view></view></view>
  </block>
</view>
