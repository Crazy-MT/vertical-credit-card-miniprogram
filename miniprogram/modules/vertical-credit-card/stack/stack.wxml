<view class="vc-view stack" style="{{heightStyle}}"><view wx:for="{{positions}}" wx:key="id" class="vc-view stack-card" style="{{item.style}}" data-index="{{index}}" bindtap="selectCard"><vertical-card preset="{{item.preset}}" width="{{width}}" bank-name="{{item.bankName}}" card-number="{{item.cardNumber}}" card-holder="{{item.cardHolder}}" expiry-date="{{item.expiryDate}}" cvv="{{item.cvv}}" enable-flip="{{false}}" enable-privacy-toggle="{{false}}" enable-3-d-tilt="{{false}}" /></view></view>
