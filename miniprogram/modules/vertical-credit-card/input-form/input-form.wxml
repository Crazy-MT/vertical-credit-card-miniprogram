<view class="vc-view form"><view class="vc-view field"><text class="vc-text">卡号 · {{brand}}</text><input class="vc-input" type="text" value="{{numberValue}}" maxlength="19" placeholder="0000 0000 0000 0000" bindinput="changeNumber" /></view><view class="vc-view field"><text class="vc-text">持卡人</text><input class="vc-input" value="{{holderValue}}" maxlength="26" placeholder="CARDHOLDER NAME" bindinput="changeHolder" /></view><view class="vc-view row"><view class="vc-view field"><text class="vc-text">有效期</text><input class="vc-input" value="{{expiryValue}}" maxlength="5" placeholder="MM/YY" bindinput="changeExpiry" /></view><view class="vc-view field"><text class="vc-text">CVV / CVC</text><input class="vc-input" type="number" password value="{{cvvValue}}" maxlength="4" placeholder="•••" bindinput="changeCvv" bindfocus="focusCvv" bindblur="blurCvv" /></view></view></view>
